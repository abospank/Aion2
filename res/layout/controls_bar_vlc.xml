<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    android:id="@id/control_bar"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:visibility="visible"
    android:layoutDirection="ltr"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <View
        android:id="@+id/aion_top_bg"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/aion_player_topbar"
        app:layout_constraintWidth_percent="1.0"
        app:layout_constraintHeight_percent="0.13"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <View
        android:id="@+id/aion_top_gold_line"
        android:layout_width="0dp"
        android:layout_height="2dp"
        android:background="#FFFFC400"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="@id/aion_top_bg"/>

    <TextView
        android:id="@+id/aion_back"
        android:layout_width="58dp"
        android:layout_height="50dp"
        android:layout_marginStart="30dp"
        android:gravity="center"
        android:text="←"
        android:textSize="32sp"
        android:textStyle="bold"
        android:textColor="#FFFFD84A"
        android:background="@drawable/aion_player_button"
        android:focusable="true"
        android:clickable="true"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="@id/aion_top_bg"/>

    <ImageView
        android:id="@+id/aion_player_logo"
        android:layout_width="220dp"
        android:layout_height="86dp"
        android:src="@drawable/app_logo"
        android:scaleType="centerInside"
        android:contentDescription="AION TV GOLD"
        android:layout_marginStart="20dp"
        app:layout_constraintStart_toEndOf="@id/aion_back"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="@id/aion_top_bg"/>

    <TextView
        android:id="@id/md_movie_name"
        android:layout_width="0dp"
        android:layout_height="58dp"
        android:gravity="center_vertical"
        android:singleLine="true"
        android:ellipsize="end"
        android:textColor="#FFF5F5F5"
        android:textSize="24sp"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintStart_toEndOf="@id/aion_player_logo"
        app:layout_constraintEnd_toStartOf="@id/aion_info"
        app:layout_constraintTop_toTopOf="@id/aion_top_bg"
        app:layout_constraintBottom_toBottomOf="@id/aion_top_bg"/>

    <TextView
        android:id="@+id/aion_info"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:gravity="center"
        android:text="ⓘ"
        android:textSize="28sp"
        android:textColor="#FFFFD84A"
        android:focusable="true"
        android:clickable="true"
        android:layout_marginEnd="38dp"
        app:layout_constraintEnd_toStartOf="@id/aion_favorite"
        app:layout_constraintTop_toTopOf="@id/aion_top_bg"
        app:layout_constraintBottom_toBottomOf="@id/aion_top_bg"/>

    <TextView
        android:id="@+id/aion_favorite"
        android:layout_width="58dp"
        android:layout_height="50dp"
        android:gravity="center"
        android:text="♡"
        android:textSize="32sp"
        android:textColor="#FFFFD84A"
        android:background="@drawable/aion_player_button"
        android:focusable="true"
        android:clickable="true"
        android:layout_marginEnd="18dp"
        app:layout_constraintEnd_toStartOf="@id/aion_top_subtitles"
        app:layout_constraintTop_toTopOf="@id/aion_top_bg"
        app:layout_constraintBottom_toBottomOf="@id/aion_top_bg"/>

    <TextView
        android:id="@+id/aion_top_subtitles"
        android:layout_width="58dp"
        android:layout_height="50dp"
        android:gravity="center"
        android:text="CC"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#FFFFD84A"
        android:background="@drawable/aion_player_button"
        android:focusable="true"
        android:clickable="true"
        android:layout_marginEnd="18dp"
        app:layout_constraintEnd_toStartOf="@id/aspect_ratio"
        app:layout_constraintTop_toTopOf="@id/aion_top_bg"
        app:layout_constraintBottom_toBottomOf="@id/aion_top_bg"/>

    <Button
        android:id="@id/aspect_ratio"
        android:layout_width="58dp"
        android:layout_height="50dp"
        android:text="⛶"
        android:textSize="26sp"
        android:textColor="#FFFFD84A"
        android:background="@drawable/aion_player_button"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:clickable="true"
        android:layout_marginEnd="30dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/aion_top_bg"
        app:layout_constraintBottom_toBottomOf="@id/aion_top_bg"/>

    <TextView
        android:id="@+id/aion_sun"
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:gravity="center"
        android:text="☀"
        android:textSize="34sp"
        android:textColor="#FFFFD84A"
        android:layout_marginStart="52dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/aion_top_bg"
        android:layout_marginTop="38dp"/>

    <SeekBar
        android:id="@+id/aion_brightness"
        android:layout_width="270dp"
        android:layout_height="42dp"
        android:rotation="-90"
        android:max="100"
        android:progress="75"
        android:progressTint="#FFFFD84A"
        android:progressBackgroundTint="#FF4A3900"
        android:thumbTint="#FFFFD84A"
        android:focusable="true"
        app:layout_constraintStart_toStartOf="@id/aion_sun"
        app:layout_constraintEnd_toEndOf="@id/aion_sun"
        app:layout_constraintTop_toBottomOf="@id/aion_sun"
        android:layout_marginTop="102dp"/>

    <TextView
        android:id="@+id/aion_volume_icon"
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:gravity="center"
        android:text="♪"
        android:textSize="32sp"
        android:textColor="#FFFFD84A"
        android:layout_marginEnd="52dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/aion_top_bg"
        android:layout_marginTop="38dp"/>

    <SeekBar
        android:id="@+id/aion_volume"
        android:layout_width="270dp"
        android:layout_height="42dp"
        android:rotation="-90"
        android:max="15"
        android:progress="8"
        android:progressTint="#FFFFD84A"
        android:progressBackgroundTint="#FF4A3900"
        android:thumbTint="#FFFFD84A"
        android:focusable="true"
        app:layout_constraintStart_toStartOf="@id/aion_volume_icon"
        app:layout_constraintEnd_toEndOf="@id/aion_volume_icon"
        app:layout_constraintTop_toBottomOf="@id/aion_volume_icon"
        android:layout_marginTop="102dp"/>

    <Button
        android:id="@id/exo_rew"
        android:layout_width="90dp"
        android:layout_height="90dp"
        android:text="↶&#10;10"
        android:textColor="#FFFFD84A"
        android:textSize="22sp"
        android:textStyle="bold"
        android:gravity="center"
        android:background="@drawable/aion_player_circle"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:clickable="true"
        app:layout_constraintEnd_toStartOf="@id/exo_pause"
        app:layout_constraintTop_toTopOf="@id/exo_pause"
        app:layout_constraintBottom_toBottomOf="@id/exo_pause"
        android:layout_marginEnd="215dp"/>

    <Button
        android:id="@id/exo_play"
        android:layout_width="104dp"
        android:layout_height="104dp"
        android:text="▶"
        android:textColor="#FFFFD84A"
        android:textSize="38sp"
        android:background="@drawable/aion_player_circle"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:visibility="gone"
        android:clickable="true"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>

    <Button
        android:id="@id/exo_pause"
        android:layout_width="104dp"
        android:layout_height="104dp"
        android:text="Ⅱ"
        android:textColor="#FFFFD84A"
        android:textSize="38sp"
        android:textStyle="bold"
        android:background="@drawable/aion_player_circle"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:visibility="visible"
        android:clickable="true"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>

    <Button
        android:id="@id/exo_ffwd"
        android:layout_width="90dp"
        android:layout_height="90dp"
        android:text="↷&#10;10"
        android:textColor="#FFFFD84A"
        android:textSize="22sp"
        android:textStyle="bold"
        android:gravity="center"
        android:background="@drawable/aion_player_circle"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:clickable="true"
        app:layout_constraintStart_toEndOf="@id/exo_pause"
        app:layout_constraintTop_toTopOf="@id/exo_pause"
        app:layout_constraintBottom_toBottomOf="@id/exo_pause"
        android:layout_marginStart="215dp"/>

    <View
        android:id="@+id/aion_timeline_bg"
        android:layout_width="0dp"
        android:layout_height="74dp"
        android:background="@drawable/aion_player_timeline"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/aion_bottom_bg"/>

    <TextView
        android:id="@id/exo_position"
        android:layout_width="92dp"
        android:layout_height="54dp"
        android:gravity="center"
        android:text="00:00"
        android:textColor="#FFFFD84A"
        android:textSize="22sp"
        android:layout_marginStart="28dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/aion_timeline_bg"
        app:layout_constraintBottom_toBottomOf="@id/aion_timeline_bg"/>

    <SeekBar
        android:id="@id/seekbar"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:max="100"
        android:progressTint="#FFFFD84A"
        android:progressBackgroundTint="#FF5C4600"
        android:thumbTint="#FFFFD84A"
        android:focusable="true"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        app:layout_constraintStart_toEndOf="@id/exo_position"
        app:layout_constraintEnd_toStartOf="@id/exo_duration"
        app:layout_constraintTop_toTopOf="@id/aion_timeline_bg"
        app:layout_constraintBottom_toBottomOf="@id/aion_timeline_bg"/>

    <TextView
        android:id="@id/exo_duration"
        android:layout_width="110dp"
        android:layout_height="54dp"
        android:gravity="center"
        android:text="--:--"
        android:textColor="#FFFFD84A"
        android:textSize="22sp"
        android:layout_marginEnd="28dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/aion_timeline_bg"
        app:layout_constraintBottom_toBottomOf="@id/aion_timeline_bg"/>

    <View
        android:id="@+id/aion_bottom_bg"
        android:layout_width="0dp"
        android:layout_height="112dp"
        android:background="@drawable/aion_player_bottombar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>

    <TextView
        android:id="@+id/aion_settings"
        android:layout_width="190dp"
        android:layout_height="54dp"
        android:gravity="center"
        android:text="⚙  Paramètres"
        android:textStyle="bold"
        android:textSize="18sp"
        android:textColor="#FFFFD84A"
        android:background="@drawable/aion_player_button"
        android:focusable="true"
        android:clickable="true"
        android:layout_marginStart="35dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/aion_bottom_bg"
        app:layout_constraintBottom_toBottomOf="@id/aion_bottom_bg"/>

    <TextView
        android:id="@+id/aion_quality"
        android:layout_width="170dp"
        android:layout_height="54dp"
        android:gravity="center"
        android:text="▱  Qualité"
        android:textStyle="bold"
        android:textSize="18sp"
        android:textColor="#FFFFD84A"
        android:background="@drawable/aion_player_button"
        android:focusable="true"
        android:clickable="true"
        android:layout_marginStart="20dp"
        app:layout_constraintStart_toEndOf="@id/aion_settings"
        app:layout_constraintTop_toTopOf="@id/aion_bottom_bg"
        app:layout_constraintBottom_toBottomOf="@id/aion_bottom_bg"/>

    <TextView
        android:id="@+id/aion_bottom_subtitles"
        android:layout_width="190dp"
        android:layout_height="54dp"
        android:gravity="center"
        android:text="CC  Sous-titres"
        android:textStyle="bold"
        android:textSize="18sp"
        android:textColor="#FFFFD84A"
        android:background="@drawable/aion_player_button"
        android:focusable="true"
        android:clickable="true"
        android:layout_marginStart="20dp"
        app:layout_constraintStart_toEndOf="@id/aion_quality"
        app:layout_constraintTop_toTopOf="@id/aion_bottom_bg"
        app:layout_constraintBottom_toBottomOf="@id/aion_bottom_bg"/>

    <TextView
        android:id="@+id/aion_audio"
        android:layout_width="210dp"
        android:layout_height="54dp"
        android:gravity="center"
        android:text="♪  Pistes audio"
        android:textStyle="bold"
        android:textSize="18sp"
        android:textColor="#FFFFD84A"
        android:background="@drawable/aion_player_button"
        android:focusable="true"
        android:clickable="true"
        android:layout_marginStart="20dp"
        app:layout_constraintStart_toEndOf="@id/aion_bottom_subtitles"
        app:layout_constraintTop_toTopOf="@id/aion_bottom_bg"
        app:layout_constraintBottom_toBottomOf="@id/aion_bottom_bg"/>

    <Button
        android:id="@id/track_selector"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone"
        android:enabled="false"/>

    <ImageView
        android:id="@id/imageBackground"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="invisible"/>

    <ProgressBar
        android:id="@+id/aion_unused_progress"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone"/>

</androidx.constraintlayout.widget.ConstraintLayout>