<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    android:id="@id/control_bar"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:visibility="visible"
    android:layoutDirection="ltr"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <View android:id="@+id/aion_scrim"
        android:layout_width="0dp" android:layout_height="0dp"
        android:background="#46000000"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent"/>

    <View android:id="@+id/aion_top_bg"
        android:layout_width="0dp" android:layout_height="80dp"
        android:background="@drawable/aion_player_topbar_ref"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <View android:id="@+id/aion_top_gold_line"
        android:layout_width="0dp" android:layout_height="2dp"
        android:background="#FFFFB700"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="@id/aion_top_bg"/>

    <Button android:id="@+id/aion_back"
        android:layout_width="58dp" android:layout_height="46dp"
        android:text="‹" android:textSize="40sp" android:textStyle="bold"
        android:textColor="#FFFFE36A" android:gravity="center" android:padding="0dp"
        android:background="@drawable/aion_player_square_ref"
        android:focusable="true" android:clickable="true"
        android:layout_marginStart="32dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/aion_top_bg"
        app:layout_constraintBottom_toBottomOf="@id/aion_top_bg"/>

    <ImageView android:id="@+id/aion_player_logo"
        android:layout_width="215dp" android:layout_height="76dp"
        android:src="@drawable/aion_details_logo"
        android:scaleType="centerInside" android:contentDescription="AION TV GOLD"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toEndOf="@id/aion_back"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="@id/aion_top_bg"/>

    <View android:layout_width="2dp" android:layout_height="92dp"
        android:rotation="35" android:background="#FFFFC400"
        android:layout_marginStart="-12dp"
        app:layout_constraintStart_toStartOf="@id/aion_player_logo"
        app:layout_constraintTop_toTopOf="parent"/>
    <View android:layout_width="2dp" android:layout_height="92dp"
        android:rotation="35" android:background="#AAFF9400"
        android:layout_marginEnd="-10dp"
        app:layout_constraintEnd_toEndOf="@id/aion_player_logo"
        app:layout_constraintTop_toTopOf="parent"/>

    <TextView android:id="@id/md_movie_name"
        android:layout_width="0dp" android:layout_height="54dp"
        android:gravity="center_vertical" android:singleLine="true" android:ellipsize="end"
        android:textColor="#FFF7F7F7" android:textSize="23sp"
        android:layout_marginStart="18dp" android:layout_marginEnd="14dp"
        app:layout_constraintStart_toEndOf="@id/aion_player_logo"
        app:layout_constraintEnd_toStartOf="@id/aion_info"
        app:layout_constraintTop_toTopOf="@id/aion_top_bg"
        app:layout_constraintBottom_toBottomOf="@id/aion_top_bg"/>

    <ImageButton android:id="@+id/aion_info"
        android:layout_width="42dp" android:layout_height="42dp"
        android:src="@drawable/aion_info_gold" android:background="@android:color/transparent"
        android:contentDescription="Info" android:focusable="true" android:clickable="true"
        android:layout_marginEnd="25dp"
        app:layout_constraintEnd_toStartOf="@id/aion_favorite"
        app:layout_constraintTop_toTopOf="@id/aion_top_bg"
        app:layout_constraintBottom_toBottomOf="@id/aion_top_bg"/>

    <ImageButton android:id="@+id/aion_favorite"
        android:layout_width="54dp" android:layout_height="46dp"
        android:src="@drawable/aion_heart_gold" android:padding="11dp"
        android:background="@drawable/aion_player_square_ref"
        android:contentDescription="Favoris" android:focusable="true" android:clickable="true"
        android:layout_marginEnd="12dp"
        app:layout_constraintEnd_toStartOf="@id/aion_top_subtitles"
        app:layout_constraintTop_toTopOf="@id/aion_top_bg"
        app:layout_constraintBottom_toBottomOf="@id/aion_top_bg"/>

    <ImageButton android:id="@+id/aion_top_subtitles"
        android:layout_width="54dp" android:layout_height="46dp"
        android:src="@drawable/aion_subtitle_box_gold" android:padding="11dp"
        android:background="@drawable/aion_player_square_ref"
        android:contentDescription="Sous-titres" android:focusable="true" android:clickable="true"
        android:layout_marginEnd="12dp"
        app:layout_constraintEnd_toStartOf="@id/aion_audio_top"
        app:layout_constraintTop_toTopOf="@id/aion_top_bg"
        app:layout_constraintBottom_toBottomOf="@id/aion_top_bg"/>

    <ImageButton android:id="@+id/aion_audio_top"
        android:layout_width="54dp" android:layout_height="46dp"
        android:src="@drawable/aion_music_gold" android:padding="11dp"
        android:background="@drawable/aion_player_square_ref"
        android:contentDescription="Audio" android:focusable="true" android:clickable="true"
        android:layout_marginEnd="12dp"
        app:layout_constraintEnd_toStartOf="@id/aspect_ratio"
        app:layout_constraintTop_toTopOf="@id/aion_top_bg"
        app:layout_constraintBottom_toBottomOf="@id/aion_top_bg"/>

    <Button android:id="@id/aspect_ratio"
        android:layout_width="54dp" android:layout_height="46dp"
        android:drawableTop="@drawable/aion_fullscreen_gold"
        android:text="" android:padding="12dp"
        android:background="@drawable/aion_player_square_ref"
        android:focusable="true" android:focusableInTouchMode="true" android:clickable="true"
        android:layout_marginEnd="32dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/aion_top_bg"
        app:layout_constraintBottom_toBottomOf="@id/aion_top_bg"/>

    <ImageView android:id="@+id/aion_sun"
        android:layout_width="42dp" android:layout_height="42dp"
        android:src="@drawable/aion_sun_gold" android:contentDescription="Luminosité"
        android:layout_marginStart="52dp" android:layout_marginTop="35dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/aion_top_bg"/>

    <SeekBar android:id="@+id/aion_brightness"
        android:layout_width="268dp" android:layout_height="28dp" android:rotation="-90"
        android:max="100" android:progress="75"
        android:progressTint="#FFFFD84A" android:progressBackgroundTint="#668A6500"
        android:thumbTint="#FFFFE77A" android:splitTrack="false" android:focusable="true"
        app:layout_constraintStart_toStartOf="@id/aion_sun"
        app:layout_constraintEnd_toEndOf="@id/aion_sun"
        app:layout_constraintTop_toBottomOf="@id/aion_sun"
        android:layout_marginTop="104dp"/>

    <ImageView android:id="@+id/aion_volume_icon"
        android:layout_width="42dp" android:layout_height="42dp"
        android:src="@drawable/aion_volume_gold" android:contentDescription="Volume"
        android:layout_marginEnd="52dp" android:layout_marginTop="35dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/aion_top_bg"/>

    <SeekBar android:id="@+id/aion_volume"
        android:layout_width="268dp" android:layout_height="28dp" android:rotation="-90"
        android:max="15" android:progress="8"
        android:progressTint="#FFFFD84A" android:progressBackgroundTint="#668A6500"
        android:thumbTint="#FFFFE77A" android:splitTrack="false" android:focusable="true"
        app:layout_constraintStart_toStartOf="@id/aion_volume_icon"
        app:layout_constraintEnd_toEndOf="@id/aion_volume_icon"
        app:layout_constraintTop_toBottomOf="@id/aion_volume_icon"
        android:layout_marginTop="104dp"/>

    <Button android:id="@id/exo_rew"
        android:layout_width="92dp" android:layout_height="94dp"
        android:drawableTop="@drawable/aion_rewind_gold" android:drawablePadding="-4dp"
        android:text="10" android:textSize="20sp" android:textStyle="bold"
        android:textColor="#FFFFD84A" android:gravity="center" android:padding="8dp"
        android:background="@android:color/transparent"
        android:focusable="true" android:focusableInTouchMode="true" android:clickable="true"
        app:layout_constraintEnd_toStartOf="@id/exo_pause"
        app:layout_constraintTop_toTopOf="@id/exo_pause"
        app:layout_constraintBottom_toBottomOf="@id/exo_pause"
        android:layout_marginEnd="205dp"/>

    <Button android:id="@id/exo_play"
        android:layout_width="92dp" android:layout_height="92dp"
        android:drawableTop="@drawable/aion_play_gold" android:text="" android:padding="25dp"
        android:background="@drawable/aion_player_circle_ref"
        android:focusable="true" android:focusableInTouchMode="true"
        android:visibility="gone" android:clickable="true"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent"/>

    <Button android:id="@id/exo_pause"
        android:layout_width="92dp" android:layout_height="92dp"
        android:drawableTop="@drawable/aion_pause_gold" android:text="" android:padding="25dp"
        android:background="@drawable/aion_player_circle_ref"
        android:focusable="true" android:focusableInTouchMode="true"
        android:visibility="visible" android:clickable="true"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent"/>

    <Button android:id="@id/exo_ffwd"
        android:layout_width="92dp" android:layout_height="94dp"
        android:drawableTop="@drawable/aion_forward_gold" android:drawablePadding="-4dp"
        android:text="10" android:textSize="20sp" android:textStyle="bold"
        android:textColor="#FFFFD84A" android:gravity="center" android:padding="8dp"
        android:background="@android:color/transparent"
        android:focusable="true" android:focusableInTouchMode="true" android:clickable="true"
        app:layout_constraintStart_toEndOf="@id/exo_pause"
        app:layout_constraintTop_toTopOf="@id/exo_pause"
        app:layout_constraintBottom_toBottomOf="@id/exo_pause"
        android:layout_marginStart="205dp"/>

    <View android:layout_width="150dp" android:layout_height="2dp"
        android:rotation="-54" android:background="#D8FFB800"
        android:layout_marginStart="-45dp" android:layout_marginBottom="62dp"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintBottom_toBottomOf="parent"/>
    <View android:layout_width="95dp" android:layout_height="1dp"
        android:rotation="-54" android:background="#66FFB800"
        android:layout_marginStart="-24dp" android:layout_marginBottom="37dp"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintBottom_toBottomOf="parent"/>
    <View android:layout_width="150dp" android:layout_height="2dp"
        android:rotation="54" android:background="#D8FFB800"
        android:layout_marginEnd="-45dp" android:layout_marginBottom="62dp"
        app:layout_constraintEnd_toEndOf="parent" app:layout_constraintBottom_toBottomOf="parent"/>
    <View android:layout_width="95dp" android:layout_height="1dp"
        android:rotation="54" android:background="#66FFB800"
        android:layout_marginEnd="-24dp" android:layout_marginBottom="37dp"
        app:layout_constraintEnd_toEndOf="parent" app:layout_constraintBottom_toBottomOf="parent"/>

    <TextView android:id="@id/exo_position"
        android:layout_width="90dp" android:layout_height="44dp"
        android:gravity="center" android:text="00:00"
        android:textColor="#FFFFD84A" android:textSize="20sp"
        android:layout_marginStart="33dp" android:layout_marginBottom="18dp"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintBottom_toBottomOf="parent"/>

    <SeekBar android:id="@id/seekbar"
        android:layout_width="0dp" android:layout_height="36dp"
        android:max="100" android:progressTint="#FFFFD84A"
        android:progressBackgroundTint="#88533E00" android:thumbTint="#FFFFE77A"
        android:splitTrack="false" android:focusable="true"
        android:layout_marginStart="4dp" android:layout_marginEnd="4dp" android:layout_marginBottom="22dp"
        app:layout_constraintStart_toEndOf="@id/exo_position"
        app:layout_constraintEnd_toStartOf="@id/exo_duration"
        app:layout_constraintBottom_toBottomOf="parent"/>

    <TextView android:id="@id/exo_duration"
        android:layout_width="104dp" android:layout_height="44dp"
        android:gravity="center" android:text="--:--"
        android:textColor="#FFFFD84A" android:textSize="20sp"
        android:layout_marginEnd="33dp" android:layout_marginBottom="18dp"
        app:layout_constraintEnd_toEndOf="parent" app:layout_constraintBottom_toBottomOf="parent"/>

    <Button android:id="@id/track_selector"
        android:layout_width="1dp" android:layout_height="1dp"
        android:visibility="gone" android:enabled="false"/>

    <ImageView android:id="@id/imageBackground"
        android:layout_width="1dp" android:layout_height="1dp"
        android:visibility="invisible"/>

</androidx.constraintlayout.widget.ConstraintLayout>