<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="44.0dp"
    android:layoutDirection="ltr"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="8.0dp"
    android:paddingEnd="8.0dp"
    android:descendantFocusability="blocksDescendants"
    android:background="@android:color/transparent">

    <TextView
        android:id="@id/group_num"
        android:layout_width="46.0dp"
        android:layout_height="match_parent"
        android:gravity="center"
        android:textColor="#FFFFE28A"
        android:textSize="13.0sp"
        android:textStyle="bold"
        android:visibility="visible" />

    <TextView
        android:id="@id/group_name"
        android:layout_width="0.0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="4.0dp"
        android:layout_weight="1.0"
        android:ellipsize="marquee"
        android:gravity="center_vertical|start"
        android:marqueeRepeatLimit="marquee_forever"
        android:singleLine="true"
        android:textColor="@color/white_color"
        android:textDirection="ltr"
        android:textSize="14.0sp"
        android:visibility="visible" />

    <ImageView
        android:layout_width="18.0dp"
        android:layout_height="18.0dp"
        android:layout_marginStart="6.0dp"
        android:scaleType="fitCenter"
        android:src="@drawable/aion_chevron_gold" />

    <ImageView
        android:layout_width="@dimen/_25sdp"
        android:layout_height="@dimen/_25sdp"
        android:layout_gravity="center_vertical"
        android:scaleType="fitXY"
        android:src="@drawable/ic_lock_white_24dp"
        android:visibility="gone" />
</LinearLayout>