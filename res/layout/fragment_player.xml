<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="10dp"
    android:paddingEnd="26dp"
    android:paddingTop="24dp">

    <TextView
        android:id="@id/dialog_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/select_player"
        android:textColor="@color/white_color"
        android:textSize="22sp"
        android:textStyle="bold"/>

    <LinearLayout
        android:id="@id/linearLayout"
        android:layout_width="540dp"
        android:layout_height="54dp"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView android:layout_width="210dp" android:layout_height="match_parent" android:gravity="start|center_vertical" android:text="@string/live" android:textColor="@color/white_color" android:textSize="16sp"/>
        <Spinner android:id="@id/spinner_live" android:layout_width="300dp" android:layout_height="44dp" android:background="@drawable/button_style" android:focusable="true" android:popupBackground="@color/grey_dark"/>
    </LinearLayout>

    <LinearLayout
        android:id="@id/linearLayout9"
        android:layout_width="540dp"
        android:layout_height="54dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView android:layout_width="210dp" android:layout_height="match_parent" android:gravity="start|center_vertical" android:text="@string/movies" android:textColor="@color/white_color" android:textSize="16sp"/>
        <Spinner android:id="@id/spinner_movies" android:layout_width="300dp" android:layout_height="44dp" android:background="@drawable/button_style" android:focusable="true" android:popupBackground="@color/grey_dark"/>
    </LinearLayout>

    <LinearLayout
        android:id="@id/linearLayout8"
        android:layout_width="540dp"
        android:layout_height="54dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView android:layout_width="210dp" android:layout_height="match_parent" android:gravity="start|center_vertical" android:text="@string/series" android:textColor="@color/white_color" android:textSize="16sp"/>
        <Spinner android:id="@id/spinner_series" android:layout_width="300dp" android:layout_height="44dp" android:background="@drawable/button_style" android:focusable="true" android:popupBackground="@color/grey_dark"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="540dp"
        android:layout_height="54dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">
        <TextView android:layout_width="210dp" android:layout_height="match_parent" android:text="@string/on_demand" android:textColor="@color/white_color" android:textSize="16sp"/>
        <Spinner android:id="@id/spinner_ondemand" android:layout_width="300dp" android:layout_height="44dp" android:background="@drawable/button_style" android:focusable="true" android:popupBackground="@color/grey_dark"/>
    </LinearLayout>
</LinearLayout>
