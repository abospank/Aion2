<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:keepScreenOn="true"
    android:layoutDirection="ltr">

    <org.videolan.libvlc.util.VLCVideoLayout
        android:id="@id/video_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fitsSystemWindows="false" />

    <ProgressBar
        android:id="@id/loading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@id/menu_layout"
        android:layout_width="0.0dp"
        android:layout_height="0.0dp"
        android:layout_margin="14.0dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/channel_details_layout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:id="@id/timeNow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18.0dp"
            android:layout_marginEnd="18.0dp"
            android:fontFamily="sans"
            android:textColor="@android:color/white"
            android:textSize="28.0sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.appcompat.widget.SearchView
            android:id="@id/channel_search_view"
            android:layout_width="300.0dp"
            android:layout_height="48.0dp"
            android:layout_marginTop="14.0dp"
            android:layout_marginEnd="22.0dp"
            android:background="@drawable/aion_search_field"
            android:iconifiedByDefault="false"
            android:queryHint="Rechercher une chaîne..."
            android:visibility="gone"
            app:layout_constraintEnd_toStartOf="@id/timeNow"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/SearchViewStyle" />

        <LinearLayout
            android:id="@+id/aion_categories_panel"
            android:layout_width="0.0dp"
            android:layout_height="0.0dp"
            android:layout_marginTop="46.0dp"
            android:orientation="vertical"
            android:background="@drawable/aion_gold_panel"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_percent="0.23">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="52.0dp"
                android:background="@drawable/aion_gold_header"
                android:drawableStart="@drawable/aion_grid_gold"
                android:drawablePadding="12.0dp"
                android:gravity="center_vertical"
                android:paddingStart="16.0dp"
                android:paddingEnd="12.0dp"
                android:text="Toutes les catégories"
                android:textColor="@android:color/white"
                android:textSize="17.0sp"
                android:textStyle="bold" />

            <ListView
                android:id="@id/rv_packages"
                android:layout_width="match_parent"
                android:layout_height="0.0dp"
                android:layout_weight="1.0"
                android:background="@android:color/transparent"
                android:cacheColorHint="@android:color/transparent"
                android:clipToPadding="false"
                android:divider="@android:color/transparent"
                android:dividerHeight="2.0dp"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:listSelector="@drawable/aion_row_selector"
                android:padding="5.0dp"
                android:scrollbars="none" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/aion_channels_panel"
            android:layout_width="0.0dp"
            android:layout_height="0.0dp"
            android:layout_marginStart="14.0dp"
            android:layout_marginTop="46.0dp"
            android:orientation="vertical"
            android:background="@drawable/aion_gold_panel"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/aion_categories_panel"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_percent="0.29">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="52.0dp"
                android:background="@drawable/aion_gold_header"
                android:drawableStart="@drawable/ic_live_tv_white_36dp"
                android:drawablePadding="12.0dp"
                android:gravity="center_vertical"
                android:paddingStart="16.0dp"
                android:paddingEnd="12.0dp"
                android:text="Chaînes TV"
                android:textColor="@android:color/white"
                android:textSize="17.0sp"
                android:textStyle="bold" />

            <ListView
                android:id="@id/rv_channels"
                android:layout_width="match_parent"
                android:layout_height="0.0dp"
                android:layout_weight="1.0"
                android:background="@android:color/transparent"
                android:cacheColorHint="@android:color/transparent"
                android:clipToPadding="false"
                android:divider="@android:color/transparent"
                android:dividerHeight="2.0dp"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:listSelector="@drawable/aion_row_selector"
                android:nextFocusRight="@id/rv_epg_programs"
                android:padding="5.0dp"
                android:scrollbars="none" />
        </LinearLayout>

        <ListView
            android:id="@id/rv_epg_programs"
            android:layout_width="0.0dp"
            android:layout_height="0.0dp"
            android:layout_marginStart="14.0dp"
            android:layout_marginTop="46.0dp"
            android:background="@drawable/aion_gold_panel"
            android:cacheColorHint="@android:color/transparent"
            android:divider="@android:color/transparent"
            android:dividerHeight="2.0dp"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:listSelector="@drawable/aion_row_selector"
            android:padding="6.0dp"
            android:scrollbars="none"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/aion_channels_panel"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_percent="0.24" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@id/channel_details_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="14.0dp"
        android:layout_marginEnd="14.0dp"
        android:layout_marginBottom="12.0dp"
        android:background="@drawable/aion_gold_panel"
        android:focusable="false"
        android:padding="8.0dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageView
            android:id="@id/iv_channel_image"
            android:layout_width="@dimen/_70sdp"
            android:layout_height="@dimen/_70sdp"
            android:layout_marginStart="@dimen/_3sdp"
            android:layout_marginTop="@dimen/_3sdp"
            android:layout_marginBottom="@dimen/_3sdp"
            android:scaleType="fitCenter"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:id="@id/view5"
            android:layout_width="1.0dp"
            android:layout_height="0.0dp"
            android:layout_marginStart="@dimen/_3sdp"
            android:background="#66E0B43C"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/iv_channel_image"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@id/channelNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_3sdp"
            android:layout_marginTop="@dimen/_3sdp"
            android:textColor="#FFFFD65A"
            android:textDirection="ltr"
            android:textSize="@dimen/_12ssp"
            android:textStyle="bold"
            app:layout_constraintStart_toEndOf="@id/view5"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@id/channelName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_3sdp"
            android:textColor="@color/white_color"
            android:textDirection="ltr"
            android:textSize="@dimen/_12ssp"
            app:layout_constraintBottom_toBottomOf="@id/channelNumber"
            app:layout_constraintStart_toEndOf="@id/channelNumber"
            app:layout_constraintTop_toTopOf="@id/channelNumber" />

        <TextView
            android:id="@id/channelGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_3sdp"
            android:textColor="@color/white_color"
            android:textDirection="ltr"
            android:textSize="@dimen/_8ssp"
            android:visibility="gone"
            app:layout_constraintStart_toEndOf="@id/view5"
            app:layout_constraintTop_toBottomOf="@id/channelNumber" />

        <TextView
            android:id="@id/egp_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24.0dp"
            android:gravity="start"
            android:textColor="#FFFFD65A"
            android:textDirection="ltr"
            android:textSize="@dimen/_8ssp"
            app:layout_constraintBottom_toBottomOf="@id/channelName"
            app:layout_constraintStart_toEndOf="@id/channelName"
            app:layout_constraintTop_toTopOf="@id/channelName" />

        <TextView
            android:id="@id/egp_description"
            android:layout_width="0.0dp"
            android:layout_height="0.0dp"
            android:layout_marginStart="@dimen/_3sdp"
            android:layout_marginEnd="@dimen/_3sdp"
            android:layout_marginBottom="@dimen/_3sdp"
            android:gravity="start"
            android:maxLines="2"
            android:textColor="@color/white_color"
            android:textDirection="ltr"
            android:textSize="@dimen/_8ssp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/view5"
            app:layout_constraintTop_toBottomOf="@id/channelName" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@id/tools_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_3sdp"
        android:layout_marginEnd="14.0dp"
        android:background="@drawable/aion_gold_tool_panel"
        android:nextFocusLeft="@id/rv_epg_programs"
        android:padding="5.0dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <Button
            android:id="@id/btn_search"
            android:layout_width="@dimen/_25sdp"
            android:layout_height="@dimen/_25sdp"
            android:layout_margin="@dimen/_3sdp"
            android:background="@drawable/search_button_style"
            android:focusable="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="?android:buttonBarButtonStyle" />

        <Button
            android:id="@id/track_selector"
            android:layout_width="@dimen/_25sdp"
            android:layout_height="@dimen/_25sdp"
            android:layout_margin="@dimen/_3sdp"
            android:background="@drawable/ic_subtitle_style"
            android:enabled="false"
            android:focusable="true"
            android:scaleType="fitXY"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btn_search"
            style="?android:buttonBarButtonStyle" />

        <Button
            android:id="@id/aspect_ratio"
            android:layout_width="1.0dp"
            android:layout_height="1.0dp"
            android:background="@android:color/transparent"
            android:focusable="false"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/track_selector"
            style="?android:buttonBarButtonStyle" />

        <Button
            android:id="@id/refresh_epg"
            android:layout_width="@dimen/_25sdp"
            android:layout_height="@dimen/_25sdp"
            android:layout_margin="@dimen/_3sdp"
            android:background="@drawable/ic_epg_style"
            android:focusable="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/track_selector"
            style="?android:buttonBarButtonStyle" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <TextView
        android:id="@id/input_key"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/_3sdp"
        android:background="@drawable/aion_gold_tool_panel"
        android:padding="@dimen/_3sdp"
        android:textColor="@color/white_color"
        android:textSize="@dimen/_8ssp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>