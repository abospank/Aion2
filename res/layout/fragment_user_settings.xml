<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="@dimen/settings_detail_pad_h"
    android:paddingEnd="@dimen/settings_detail_pad_h"
    android:paddingTop="@dimen/settings_detail_pad_top">

    <TextView
        android:id="@id/dialog_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/change_pass"
        android:textColor="@color/white_color"
        android:textSize="@dimen/settings_title_size"
        android:textStyle="bold"/>

    <EditText
        android:id="@id/old_password"
        style="@style/CustomEditTextStyle"
        android:layout_width="match_parent"
        android:layout_height="@dimen/settings_control_height"
        android:layout_marginTop="@dimen/settings_control_gap"
        android:hint="@string/old_password"
        android:inputType="numberPassword"
        android:maxLength="5"
        android:maxLines="1"
        android:textSize="@dimen/settings_control_text_size"
        android:imeOptions="actionNext"/>

    <EditText
        android:id="@id/password"
        style="@style/CustomEditTextStyle"
        android:layout_width="match_parent"
        android:layout_height="@dimen/settings_control_height"
        android:layout_marginTop="@dimen/settings_control_gap"
        android:hint="@string/new_password"
        android:inputType="numberPassword"
        android:maxLength="5"
        android:maxLines="1"
        android:textSize="@dimen/settings_control_text_size"
        android:imeOptions="actionNext"/>

    <EditText
        android:id="@id/confirm_password"
        style="@style/CustomEditTextStyle"
        android:layout_width="match_parent"
        android:layout_height="@dimen/settings_control_height"
        android:layout_marginTop="@dimen/settings_control_gap"
        android:hint="@string/confirm_password"
        android:inputType="numberPassword"
        android:maxLength="5"
        android:maxLines="1"
        android:textSize="@dimen/settings_control_text_size"
        android:imeOptions="actionNext"/>

    <Button
        android:id="@id/save_password"
        android:layout_width="@dimen/settings_button_width"
        android:layout_height="@dimen/settings_control_height"
        android:layout_marginTop="@dimen/settings_control_gap"
        android:background="@drawable/button_style"
        android:text="@string/save"
        android:textColor="@color/white_color"
        android:textSize="@dimen/settings_control_text_size"
        android:textStyle="bold"/>

    <TextView
        android:id="@id/advanced_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/settings_section_gap"
        android:text="@string/advanced"
        android:textColor="@color/white_color"
        android:textSize="@dimen/settings_title_size"
        android:textStyle="bold"/>

    <CheckBox
        android:id="@id/runOnStart"
        android:theme="@style/CheckBoxStyle"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/settings_control_height"
        android:layout_marginTop="@dimen/settings_control_gap"
        android:text="@string/start_with_system"
        android:textColor="@color/white_color"
        android:textSize="@dimen/settings_control_text_size"
        android:textStyle="bold"/>

    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
        <Button
            android:id="@id/update_btn"
            android:layout_width="@dimen/settings_button_width"
            android:layout_height="@dimen/settings_control_height"
            android:layout_marginTop="@dimen/settings_control_gap"
            android:background="@drawable/button_style"
            android:text="@string/update"
            android:textColor="@color/white_color"
            android:textSize="@dimen/settings_control_text_size"
            android:visibility="gone"/>
        <Button
            android:id="@id/reset_btn"
            android:layout_width="@dimen/settings_button_width"
            android:layout_height="@dimen/settings_control_height"
            android:layout_marginStart="@dimen/settings_control_gap"
            android:layout_marginTop="@dimen/settings_control_gap"
            android:background="@drawable/button_style"
            android:text="@string/reset"
            android:textColor="@color/white_color"
            android:textSize="@dimen/settings_control_text_size"/>
    </LinearLayout>

    <ProgressBar
        android:id="@id/loading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"/>
</LinearLayout>