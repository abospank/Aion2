<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="#FFE3B63F"
                android:centerColor="#D99B6418"
                android:endColor="#B66B3505"/>
            <stroke android:width="2dp" android:color="#FFFFD75A"/>
        </shape>
    </item>
</selector>